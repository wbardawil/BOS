# BDS environment variables — copy to .env.local and fill with real values.
# ALL values below are fictional. NEVER commit a real secret.

# ── Supabase (DB + RLS + pgvector + Storage) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiJ9.fictional-anon-key
# Service role: ONLY used inside Inngest jobs with explicit org scoping (law #1).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiJ9.fictional-service-role-key
SUPABASE_DB_PASSWORD=fictional-db-password
SUPABASE_PROJECT_ID=abcdefghijklmnop

# ── Clerk (auth: orgs + memberships, third-party JWT into Supabase RLS) ──────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_fictional1234567890
CLERK_SECRET_KEY=sk_test_fictional1234567890
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Anthropic (every call goes through @bos/ai — law #3) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-fictional1234567890

# ── Inngest (agent runs, cadence cron, approval-gated workflows) ─────────────
INNGEST_EVENT_KEY=fictional-inngest-event-key
INNGEST_SIGNING_KEY=signkey-test-fictional1234567890

# ── Stripe (subscriptions + metered usage; Stripe MX entity) ─────────────────
STRIPE_SECRET_KEY=sk_test_fictional1234567890
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_fictional1234567890
STRIPE_WEBHOOK_SECRET=whsec_fictional1234567890

# ── Langfuse (trace every LLM call — per-account margin visibility) ──────────
LANGFUSE_PUBLIC_KEY=pk-lf-fictional1234567890
LANGFUSE_SECRET_KEY=sk-lf-fictional1234567890
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Sentry (errors) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://fictional@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=sntrys_fictional1234567890

# ── Resend (cadence nudges, approval emails) ─────────────────────────────────
RESEND_API_KEY=re_fictional1234567890
RESEND_FROM_EMAIL=notifications@example-bds.test
